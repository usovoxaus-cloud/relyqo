DATABASE_URL=postgresql+psycopg://relyqo:relyqo@postgres:5432/relyqo
REDIS_URL=redis://redis:6379/0
QR_SECRET=replace-with-at-least-32-random-characters
OWNER_PASSWORD=replace-with-a-strong-owner-password
REVIEW_PASSWORD=replace-with-a-different-relyqo-review-password
ADMIN_PASSWORD=replace-with-a-strong-relyqo-admin-password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_MAPS_BROWSER_KEY=
PUBLIC_BASE_URL=http://localhost:8000
DEMO_MODE=true
CORS_ORIGINS=http://localhost:8000

# Password recovery via HTTPS (compatible with Render Free).
# Sender must belong to a domain verified in Resend. Never expose the key to frontend.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
RECOVERY_ALLOW_LOCAL_URLS=false

# SMS recovery (off until all required fields and allowed regions are configured).
# Set these ONLY on the server. Never commit credentials or put them in mobile builds.
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Use the sender assigned/approved for your Eskiz account.
ESKIZ_SENDER=4546
# Submit this exact text with a variable six-digit code for provider moderation first.
ESKIZ_MESSAGE_TEMPLATE=RELYQO: Tasdiqlash kodi {code}. Kodni hech kimga bermang. 10 daqiqa amal qiladi.
# Generate an independent random secret (at least 32 characters); see docs/phone-recovery.md.
SMS_OTP_SECRET=
# Optional alternate provider, only selected explicitly with SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Initial Eskiz launch: UZ. Keep empty until the account/template/delivery are verified.
# International Twilio setup must also match Verify Geo Permissions.
SMS_ALLOWED_REGIONS=
